<Window x:Class="ZupuPaiBan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ZupuPaiBan.ViewModels"
        xmlns:services="clr-namespace:ZupuPaiBan.Services"
        xmlns:conv="clr-namespace:ZupuPaiBan.Converters"
        xmlns:models="clr-namespace:ZupuPaiBan.Models"
        mc:Ignorable="d"
        Title="谱匠" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Window.Resources>
        <conv:GenderToStringConverter x:Key="GenderToString"/>
        <conv:GenerationToDisplayConverter x:Key="GenToString"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 菜单栏 -->
        <Menu Grid.Row="0" Background="#F5F0E8">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="数据库备份与校验…" Click="DatabaseBackup_Click"/>
                <Separator/>
                <MenuItem Header="导入 Excel 数据" Command="{Binding ImportFromExcelCommand}"/>
                <MenuItem Header="导入 GEDCOM 数据" Command="{Binding ImportFromGedcomCommand}"/>
                <MenuItem Header="导入内部 JSON…" Click="InternalJsonImport_Click"/>
                <MenuItem Header="导入外部兼容格式…" Click="ExternalExchangeImport_Click"/>
                <Separator/>
                <MenuItem Header="导出 Excel 数据" Command="{Binding ExportToExcelCommand}"/>
                <MenuItem Header="导出 GEDCOM 数据" Command="{Binding ExportToGedcomCommand}"/>
                <Separator/>
                <MenuItem Header="退出" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="协作(_C)">
                <MenuItem Header="协作导出..." Command="{Binding ExportCollaborationCommand}"/>
                <MenuItem Header="协作导入..." Command="{Binding ImportCollaborationCommand}"/>
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="关于" Click="BtnAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- 工具栏 -->
        <ToolBar Grid.Row="1" Background="#F5F0E8">
            <Button Command="{Binding AddRootMemberCommand}" Padding="8,4" Margin="2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="➕" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text=" 添加根成员" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Command="{Binding AddChildMemberCommand}" Padding="8,4" Margin="2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="➕" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text=" 添加子成员" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Command="{Binding EditMemberCommand}" Padding="8,4" Margin="2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✏️" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text=" 编辑" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Command="{Binding DeleteMemberCommand}" Padding="8,4" Margin="2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🗑️" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text=" 删除" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Command="{Binding OpenPreviewCommand}" Padding="8,4" Margin="2"
                    Background="#E8D8C0" FontWeight="Bold">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📄" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text=" 排版预览/打印" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button x:Name="btnAbout" Click="BtnAbout_Click" Padding="8,4" Margin="2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ℹ️" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text=" 关于" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </ToolBar>

        <GroupBox Grid.Row="2" Header="目标模型族谱" Margin="5" x:Name="genealogyPanel">
            <StackPanel Margin="5">
                <WrapPanel>
                    <TextBlock Text="名称：" VerticalAlignment="Center"/>
                    <TextBox Width="160" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="创建族谱" Click="CreateGenealogy_Click" Margin="5,0,15,0" Padding="8,2"/>
                    <TextBlock Text="当前族谱：" VerticalAlignment="Center"/>
                    <ComboBox x:Name="genealogySelector" Width="180" ItemsSource="{Binding Genealogies}"
                              DisplayMemberPath="Name" SelectedItem="{Binding SelectedGenealogy}"
                              SelectionChanged="GenealogySelector_SelectionChanged"/>
                </WrapPanel>
                <WrapPanel Margin="0,5,0,0">
                    <TextBlock Text="人物姓名：" VerticalAlignment="Center"/>
                    <TextBox Width="160" Text="{Binding NewPersonName, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="添加人物" Click="AddPerson_Click" Margin="5,0,0,0" Padding="8,2"/>
                </WrapPanel>
                <TextBlock Text="{Binding Status}" Margin="0,5,0,0"/>
                <ListBox MaxHeight="70" ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson}"
                         SelectionChanged="TargetPerson_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}"/>
                                <TextBlock Text="  ID: "/>
                                <TextBlock Text="{Binding Id}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <WrapPanel Margin="0,5,0,0">
                    <TextBlock Text="{Binding SelectedParentStatus}" VerticalAlignment="Center"/>
                    <Button Content="取消选择人物" Click="ClearSelectedPerson_Click" Margin="8,0,0,0" Padding="8,2"/>
                    <Button Content="删除所选人物" Click="DeleteTargetPerson_Click" Margin="8,0,0,0" Padding="8,2"/>
                </WrapPanel>
                <WrapPanel Margin="0,5,0,0">
                    <TextBlock Text="所选人物的生物子女姓名：" VerticalAlignment="Center"/>
                    <TextBox Width="160" Text="{Binding NewChildName, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="添加子女" Click="AddChild_Click" Margin="5,0,0,0" Padding="8,2"/>
                </WrapPanel>
                <WrapPanel Margin="0,5,0,0">
                    <TextBlock Text="关联已有生物子女：" VerticalAlignment="Center"/>
                    <ComboBox Width="340" ItemsSource="{Binding People}" SelectedItem="{Binding SelectedExistingChild}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}"/>
                                    <TextBlock Text="  ID: "/>
                                    <TextBlock Text="{Binding Id}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="关联子女" Click="AddExistingChild_Click" Margin="5,0,0,0" Padding="8,2"/>
                </WrapPanel>
                <TextBlock Text="{Binding ChildrenStatus}" Margin="0,5,0,0"/>
                <ListBox MaxHeight="55" ItemsSource="{Binding BiologicalChildren}" SelectedItem="{Binding SelectedBiologicalChild}"
                         DisplayMemberPath="Name" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                <Button Content="解除所选生物父母关系" Click="RemoveBiologicalParentRelationship_Click"
                        HorizontalAlignment="Left" Margin="0,5,0,0" Padding="8,2"/>
                <WrapPanel Margin="0,5,0,0">
                    <TextBlock Text="修改所选姓名：" VerticalAlignment="Center"/>
                    <TextBox Width="160" Text="{Binding EditedPersonName, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="保存姓名" Click="RenamePerson_Click" Margin="5,0,0,0" Padding="8,2"/>
                </WrapPanel>
                <WrapPanel Margin="0,5,0,0">
                    <TextBlock Text="性别：" VerticalAlignment="Center"/>
                    <ComboBox Width="80" SelectedValuePath="Tag" SelectedValue="{Binding EditedSex}">
                        <ComboBoxItem Content="未知" Tag="{x:Static models:PersonSex.Unknown}"/>
                        <ComboBoxItem Content="男" Tag="{x:Static models:PersonSex.Male}"/>
                        <ComboBoxItem Content="女" Tag="{x:Static models:PersonSex.Female}"/>
                    </ComboBox>
                    <TextBlock Text=" 出生：" VerticalAlignment="Center"/>
                    <TextBox Width="110" Text="{Binding EditedBirthDate, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text=" 逝世：" VerticalAlignment="Center"/>
                    <TextBox Width="110" Text="{Binding EditedDeathDate, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text=" 生平：" VerticalAlignment="Center"/>
                    <TextBox Width="160" Text="{Binding EditedBiography, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="保存档案" Click="SavePersonProfile_Click" Margin="5,0,0,0" Padding="8,2"/>
                </WrapPanel>
                <TextBlock Text="下方旧版成员树及其导入、排版功能独立于此选择。" Foreground="#805020" TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>

        <!-- 主内容区 -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：目标只读关系树与旧版原型 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <GroupBox Grid.Row="0" Header="目标谱系（关系清单，不选择主线）" Margin="5"
                          BorderBrush="#C0A080" BorderThickness="1.5" DataContext="{Binding DataContext, ElementName=genealogyPanel}"
                          IsEnabled="{Binding IsEnabled, ElementName=genealogyPanel}">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="3">
                            <Button Content="编辑目标人物" Click="TargetShortcut_Edit_Click" Margin="0,0,5,4" Padding="6,2"/>
                            <Button Content="为目标人物新增子女" Click="TargetShortcut_AddChild_Click" Margin="0,0,0,4" Padding="6,2"/>
                        </WrapPanel>
                    <TreeView x:Name="targetTree" ItemsSource="{Binding TargetTree}" SelectedItemChanged="TargetTree_SelectedItemChanged"
                              ToolTip="选择人物查看档案；双击编辑档案；右键添加生物子女。">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type services:TargetMemberTreeNode}" ItemsSource="{Binding Details}">
                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" MouseLeftButtonDown="TargetTreePerson_MouseLeftButtonDown">
                                    <TextBlock.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="新增生物子女" Click="TargetTree_AddChild_Click"
                                                      Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        </ContextMenu>
                                    </TextBlock.ContextMenu>
                                </TextBlock>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                    </DockPanel>
                </GroupBox>
            <GroupBox Grid.Row="1" Header="旧版原型成员树" Margin="5"
                      BorderBrush="#C0A080" BorderThickness="1.5">
                <TreeView x:Name="treeMembers"
                          ItemsSource="{Binding TreeNodes}"
                          SelectedItemChanged="TreeMembers_SelectedItemChanged"
                          MouseDoubleClick="TreeMembers_MouseDoubleClick"
                          BorderThickness="0">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="Padding" Value="4,3"/>
                            <Setter Property="Margin" Value="0,1"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,6,0"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#4A7AB5"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Member.Gender}" Value="{x:Static models:Gender.Female}">
                                                    <Setter Property="Background" Value="#D46A8A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Text="{Binding Member.Name}" FontWeight="SemiBold"
                                           FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Member.Gender, Converter={StaticResource GenderToString}}"
                                           FontSize="11" Foreground="Gray" Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Member.Generation, Converter={StaticResource GenToString}}"
                                           FontSize="10" Foreground="#999" Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="添加根成员" Command="{Binding AddRootMemberCommand}"/>
                            <MenuItem Header="添加子成员" Command="{Binding AddChildMemberCommand}"/>
                            <Separator/>
                            <MenuItem Header="编辑" Command="{Binding EditMemberCommand}"/>
                            <MenuItem Header="删除" Command="{Binding DeleteMemberCommand}"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>
            </GroupBox>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" Background="#DDD" HorizontalAlignment="Stretch"/>

            <!-- 右侧：选中成员详情 -->
            <GroupBox Grid.Column="2" Header="成员详情" Margin="5"
                      BorderBrush="#C0A080" BorderThickness="1.5">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 无选中时的提示 -->
                    <TextBlock Grid.Row="0" Text="请在左侧选择一位成员查看详情，或双击成员进行编辑"
                               Foreground="Gray" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="20,40">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNode}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 成员详情面板 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding SelectedNode, Converter={StaticResource NullToVis}}">
                        <StackPanel x:Name="detailPanel" DataContext="{Binding SelectedNode.Member}">
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="姓名:" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="0,4"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" FontSize="16"
                                           FontWeight="Bold" VerticalAlignment="Center" Margin="0,4"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="性别:" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="0,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Gender, Converter={StaticResource GenderToString}}"
                                           VerticalAlignment="Center" Margin="0,4"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="出生日期:" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="0,4"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BirthDate}"
                                           VerticalAlignment="Center" Margin="0,4"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="逝世日期:" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="0,4"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DeathDate}"
                                           VerticalAlignment="Center" Margin="0,4" Foreground="Gray"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="配偶:" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="0,4"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SpouseName}"
                                           VerticalAlignment="Center" Margin="0,4"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="辈分:" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="0,4"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Generation, Converter={StaticResource GenToString}}"
                                           VerticalAlignment="Center" Margin="0,4"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="排行:" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="0,4"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding BirthOrder, StringFormat='第{0}位'}"
                                           VerticalAlignment="Center" Margin="0,4"/>

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="生平:" FontWeight="Bold"
                                           VerticalAlignment="Top" Margin="0,4"/>
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Biography}"
                                           TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,4"
                                           Foreground="#555"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="4" Background="#F5F0E8">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
