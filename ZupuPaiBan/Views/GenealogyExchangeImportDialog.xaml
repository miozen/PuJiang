<Window x:Class="ZupuPaiBan.Views.GenealogyExchangeImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入内部 JSON" Height="470" Width="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="选择内部 JSON…" Click="SelectFile_Click" Padding="12,5" Margin="0,0,10,0"/>
            <TextBlock x:Name="SelectedFileText" Text="未选择文件" VerticalAlignment="Center" Foreground="Gray" TextTrimming="CharacterEllipsis" MaxWidth="400"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="导入方式" FontWeight="Bold" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="DefaultImportMode" Content="默认导入（拒绝任何来源 ID 冲突）" IsChecked="True" Checked="ModeChanged" Margin="0,0,16,0"/>
                <RadioButton x:Name="CopyImportMode" Content="导入为新族谱副本" Checked="ModeChanged"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="副本显示名称（仅副本模式；不用于匹配或覆盖）" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBox x:Name="CopyNameText" IsEnabled="False" TextChanged="CopyNameChanged" MaxLength="200"/>
        </StackPanel>

        <Border Grid.Row="3" BorderBrush="#C8C8C8" BorderThickness="1" Padding="10" Margin="0,0,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="PreflightText" Text="请选择内部 JSON 文件，系统会先预检且不会写入数据。" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ConfirmImportButton" Content="确认导入" Click="ConfirmImport_Click" IsEnabled="False"
                    Padding="20,6" Margin="5,0" Background="#4A7AB5" Foreground="White" FontWeight="Bold"/>
            <Button Content="取消" Click="Cancel_Click" Padding="15,6" Margin="5,0"/>
        </StackPanel>
    </Grid>
</Window>
