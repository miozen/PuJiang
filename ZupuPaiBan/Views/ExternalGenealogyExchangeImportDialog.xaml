<Window x:Class="ZupuPaiBan.Views.ExternalGenealogyExchangeImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入外部兼容格式" Height="480" Width="650"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="选择 Excel 或 GEDCOM…" Click="SelectFile_Click" Padding="12,5" Margin="0,0,10,0"/>
            <TextBlock x:Name="SelectedFileText" Text="未选择文件" VerticalAlignment="Center" Foreground="Gray" TextTrimming="CharacterEllipsis" MaxWidth="380"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="新族谱显示名称（不会匹配、覆盖或合并既有数据）" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBox x:Name="GenealogyNameText" MaxLength="200" TextChanged="GenealogyNameChanged"/>
        </StackPanel>
        <Border Grid.Row="2" BorderBrush="#C8C8C8" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="PreflightText" Text="请选择外部 Excel 或 GEDCOM 文件。系统会先预检且不会写入数据。" TextWrapping="Wrap"/></ScrollViewer>
        </Border>
        <CheckBox Grid.Row="3" x:Name="AcceptLossesCheck" Content="我已阅读并接受上述无法安全映射的数据损失" IsEnabled="False" Checked="AcceptLossesChanged" Unchecked="AcceptLossesChanged" Margin="0,0,0,12"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ConfirmImportButton" Content="确认导入为新族谱" Click="ConfirmImport_Click" IsEnabled="False" Padding="20,6" Margin="5,0" Background="#4A7AB5" Foreground="White" FontWeight="Bold"/>
            <Button Content="取消" Click="Cancel_Click" Padding="15,6" Margin="5,0"/>
        </StackPanel>
    </Grid>
</Window>
