<Window x:Class="ZupuPaiBan.Views.GenealogyProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑族谱资料" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" MinWidth="440">
    <StackPanel Margin="18">
        <TextBlock x:Name="GenealogyLabel" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBlock Text="谱载姓氏（可选，不限制人物姓氏）："/>
        <TextBox x:Name="SurnameBox" MaxLength="100" Margin="0,4,0,10"/>
        <TextBlock Text="族谱简介（可选）："/>
        <TextBox x:Name="DescriptionBox" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto" Margin="0,4,0,12"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" Padding="14,4" Margin="0,0,8,0"/>
            <Button x:Name="SaveButton" Content="保存" IsDefault="True" Padding="14,4" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
