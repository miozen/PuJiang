<Window x:Class="ZupuPaiBan.Views.TargetPersonEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ZupuPaiBan.Models"
        Title="编辑人物基础档案" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" MinWidth="400">
    <StackPanel Margin="18">
        <TextBlock x:Name="PersonIdLabel" Margin="0,0,0,10"/>
        <TextBlock Text="姓名："/><TextBox x:Name="NameBox" MaxLength="200" Margin="0,4,0,8"/>
        <TextBlock Text="性别："/>
        <ComboBox x:Name="SexBox" SelectedValuePath="Tag" Margin="0,4,0,8">
            <ComboBoxItem Content="未知" Tag="{x:Static models:PersonSex.Unknown}"/>
            <ComboBoxItem Content="男" Tag="{x:Static models:PersonSex.Male}"/>
            <ComboBoxItem Content="女" Tag="{x:Static models:PersonSex.Female}"/>
        </ComboBox>
        <TextBlock Text="出生："/><TextBox x:Name="BirthBox" MaxLength="100" Margin="0,4,0,8"/>
        <TextBlock Text="逝世："/><TextBox x:Name="DeathBox" MaxLength="100" Margin="0,4,0,8"/>
        <TextBlock Text="生平："/><TextBox x:Name="BiographyBox" MaxLength="4000" AcceptsReturn="True" TextWrapping="Wrap" Height="80" VerticalScrollBarVisibility="Auto" Margin="0,4,0,12"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" Padding="14,4" Margin="0,0,8,0"/>
            <Button Content="保存" IsDefault="True" Padding="14,4" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
