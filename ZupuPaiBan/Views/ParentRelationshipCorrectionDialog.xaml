<Window x:Class="ZupuPaiBan.Views.ParentRelationshipCorrectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ZupuPaiBan.Models"
        Title="更正父母关系类型" Width="650" Height="410" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <TextBlock x:Name="SubjectLabel" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock Text="选择更正后的类型："/>
            <ComboBox x:Name="KindBox" SelectedValuePath="Tag" Margin="0,4,0,8">
                <ComboBoxItem Content="生物父母" Tag="{x:Static models:PersonRelationshipKind.BiologicalParent}"/>
                <ComboBoxItem Content="养父母" Tag="{x:Static models:PersonRelationshipKind.AdoptiveParent}"/>
                <ComboBoxItem Content="继嗣父母" Tag="{x:Static models:PersonRelationshipKind.HeirParent}"/>
            </ComboBox>
            <TextBlock Text="保留关系 ID、双方、备注和来源；不会修改其他记录。" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="取消" IsCancel="True" Padding="14,4" Margin="0,0,8,0"/>
                <Button x:Name="ConfirmButton" Content="确认更正" Click="Confirm_Click" Padding="14,4"/>
            </StackPanel>
        </StackPanel>
        <ListBox x:Name="CandidateList">
            <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Description}"/><StackPanel Orientation="Horizontal"><TextBlock Text="记录 ID: "/><TextBlock Text="{Binding Id}"/></StackPanel></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
