<Window x:Class="ZupuPaiBan.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 谱匠" Height="300" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0"
                   Text="谱匠"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Foreground="#8B5E3C"
                   Margin="0,0,0,10"/>

        <!-- 版本 -->
        <TextBlock Grid.Row="1"
                   Text="版本 1.0.0"
                   FontSize="12"
                   Foreground="Gray"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- 说明 -->
        <TextBlock Grid.Row="2"
                   Text="专业的族谱管理、排版与打印工具"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,30"/>

        <!-- 作者和版权 -->
        <StackPanel Grid.Row="3" VerticalAlignment="Center">
            <TextBlock HorizontalAlignment="Center" Margin="0,5">
                <Run Text="作者：" FontWeight="Bold"/>
                <Run Text="算神"/>
            </TextBlock>
            <TextBlock HorizontalAlignment="Center" Margin="0,5">
                <Run Text="版权所有：" FontWeight="Bold"/>
                <Run Text="© 2026 算神工作室"/>
            </TextBlock>
        </StackPanel>

        <!-- 确定按钮 -->
        <Button Grid.Row="4"
                Content="确定"
                Width="100"
                Height="30"
                Click="BtnOk_Click"
                IsDefault="True"
                HorizontalAlignment="Center"
                Background="#4A7AB5"
                Foreground="White"
                FontWeight="Bold"/>
    </Grid>
</Window>
