<Window x:Class="ZupuPaiBan.Views.LineageTreeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:ZupuPaiBan.Services"
        Title="树形世系浏览" Width="1100" Height="700" MinWidth="760" MinHeight="500" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="主线是展示投影，不修改原始关系；请显式保存图表配置。未选择及未记录上系不推断始祖。" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="已保存图表：" VerticalAlignment="Center"/>
            <ComboBox x:Name="Charts" Width="170" DisplayMemberPath="Name" Margin="4,0"/>
            <Button x:Name="OpenChartButton" Content="打开" Click="OpenChart_Click" Padding="8,3" Margin="4,0"/>
            <Button x:Name="NewChartButton" Content="新建" Click="NewChart_Click" Padding="8,3" Margin="4,0"/>
            <TextBlock Text="图表名称：" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <TextBox x:Name="ChartName" Width="150"/>
            <Button x:Name="SaveChartButton" Content="保存图表" Click="SaveChart_Click" Padding="8,3" Margin="8,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="失效选线（须重新选择或明确清除后才能保存）：" />
            <ListBox x:Name="InvalidChoices" DisplayMemberPath="Label" Height="48"/>
            <Button x:Name="ClearInvalidButton" Content="明确清除所选失效项" Click="ClearInvalid_Click" HorizontalAlignment="Left" Padding="8,2"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="姓名或人物 ID：" VerticalAlignment="Center"/>
            <TextBox x:Name="SearchBox" Width="160" TextChanged="SearchBox_TextChanged"/>
            <ComboBox x:Name="SearchResults" Width="340" DisplayMemberPath="Label" Margin="8,0"/>
            <Button x:Name="LocateButton" Content="定位" Click="Locate_Click" Padding="10,3"/>
            <Button x:Name="ClearSelectionButton" Content="清除人物选择" Click="ClearSelection_Click" Margin="8,0,0,0" Padding="10,3"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <Button Content="关闭" IsCancel="True" Padding="14,4" HorizontalAlignment="Right"/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <GroupBox Header="树形世系（可展开或折叠）" Margin="0,0,8,0">
                <TreeView x:Name="LineageTree" SelectedItemChanged="LineageTree_SelectedItemChanged">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type services:LineageTreeNode}" ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap">
                                <TextBlock.Style><Style TargetType="TextBlock">
                                    <Style.Triggers><DataTrigger Binding="{Binding IsPathAncestor}" Value="True">
                                        <Setter Property="Background" Value="#FFFFD98A"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                    <TreeView.ItemContainerStyle><Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                    </Style></TreeView.ItemContainerStyle>
                </TreeView>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="所选人物的父母关系">
                <DockPanel Margin="6">
                    <TextBox x:Name="DetailsText" DockPanel.Dock="Top" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6"/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button x:Name="ChooseButton" Content="选择这条关系" IsEnabled="False" Click="Choose_Click" Padding="10,4" Margin="0,0,8,0"/>
                        <Button x:Name="ClearButton" Content="清除本次选择" IsEnabled="False" Click="Clear_Click" Padding="10,4"/>
                    </StackPanel>
                    <ListBox x:Name="CandidateList" SelectionChanged="CandidateList_SelectionChanged" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="0,3"/></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
