<Window x:Class="ZupuPaiBan.Views.TargetFamilyUnionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ZupuPaiBan.Models"
        Title="新增婚配关系" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" MinWidth="440">
    <StackPanel Margin="18">
        <TextBlock Text="婚配第一方（锁定为当前所选人物）："/>
        <TextBlock x:Name="PartnerOneLabel" Margin="0,4,0,10" TextWrapping="Wrap"/>
        <TextBlock Text="婚配类型："/>
        <ComboBox x:Name="KindBox" SelectedValuePath="Tag" Margin="0,4,0,8">
            <ComboBoxItem Content="婚姻" Tag="{x:Static models:FamilyUnionKind.Marriage}"/>
            <ComboBoxItem Content="伴侣关系" Tag="{x:Static models:FamilyUnionKind.Partnership}"/>
            <ComboBoxItem Content="类型未详" Tag="{x:Static models:FamilyUnionKind.Unknown}"/>
        </ComboBox>
        <TextBlock Text="婚配第二方（仅当前族谱）："/>
        <ComboBox x:Name="PartnerTwoBox" Margin="0,4,0,12">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}"/>
                        <TextBlock Text="  ID: "/>
                        <TextBlock Text="{Binding Id}"/>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Foreground="#805020" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="保存只新增这一条无向婚配记录；不会自动创建配偶人物关系、合并人物或覆盖既有记录。"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" Padding="14,4" Margin="0,0,8,0"/>
            <Button Content="新增婚配" IsDefault="True" Padding="14,4" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
