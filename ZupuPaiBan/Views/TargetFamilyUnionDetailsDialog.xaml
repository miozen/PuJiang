<Window x:Class="ZupuPaiBan.Views.TargetFamilyUnionDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑婚配资料" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" MinWidth="560" MaxHeight="650">
    <StackPanel Margin="18">
        <TextBlock x:Name="SubjectLabel" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBlock Text="选择一条婚配（含记录 ID）："/>
        <ListBox x:Name="CandidateList" MinHeight="90" MaxHeight="140" Margin="0,4,0,8" SelectionChanged="CandidateList_SelectionChanged">
            <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Description}"/><StackPanel Orientation="Horizontal"><TextBlock Text="记录 ID: "/><TextBlock Text="{Binding Id}"/></StackPanel></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="始于（文字）："/><TextBox x:Name="StartDateBox" MaxLength="100" Margin="0,4,0,8"/>
        <TextBlock Text="止于（文字）："/><TextBox x:Name="EndDateBox" MaxLength="100" Margin="0,4,0,8"/>
        <TextBlock Text="备注："/><TextBox x:Name="NoteBox" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto" Margin="0,4,0,12"/>
        <TextBlock Text="保存只修改所选婚配的起止时间文字和备注。" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" Padding="14,4" Margin="0,0,8,0"/>
            <Button x:Name="SaveButton" Content="保存" IsDefault="True" IsEnabled="False" Padding="14,4" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
