<Window x:Class="ZupuPaiBan.Views.PersonDeletePreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="删除人物预览" Width="660" Height="460" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <TextBlock x:Name="Subject" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="Guidance" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="关闭" IsCancel="True" Padding="14,4" Margin="0,0,8,0"/>
                <Button x:Name="DeleteButton" Content="确认删除" Click="Delete_Click" Padding="14,4"/>
            </StackPanel>
        </StackPanel>
        <ListBox x:Name="LinkList" DisplayMemberPath="Description"/>
    </DockPanel>
</Window>
