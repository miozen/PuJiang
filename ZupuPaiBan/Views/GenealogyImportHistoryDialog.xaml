<Window x:Class="ZupuPaiBan.Views.GenealogyImportHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入来源记录" Width="680" Height="480" MinWidth="480" MinHeight="300"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="18">
        <TextBlock x:Name="GenealogyLabel" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBlock DockPanel.Dock="Top" Text="仅显示导入追溯信息，不能证明资料真实性。" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <Button x:Name="CloseButton" DockPanel.Dock="Bottom" Content="关闭" IsCancel="True" Click="Close_Click" HorizontalAlignment="Right" Padding="14,4" Margin="0,10,0,0"/>
        <TextBox x:Name="HistoryText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
    </DockPanel>
</Window>
