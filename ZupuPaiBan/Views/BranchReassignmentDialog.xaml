<Window x:Class="ZupuPaiBan.Views.BranchReassignmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安置内容并删除房支" Width="720" Height="620" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock Text="直属子房支的新上级（须明确选择）："/>
            <ComboBox x:Name="ChildTarget" DisplayMemberPath="Label" Margin="0,4,0,8"/>
            <TextBlock Text="直属人物的新房支（可明确选择未归属）："/>
            <ComboBox x:Name="PersonTarget" DisplayMemberPath="Label" Margin="0,4,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" IsCancel="True" Padding="14,4" Margin="0,0,8,0"/>
                <Button x:Name="ConfirmButton" Content="查看确认" Click="Confirm_Click" Padding="14,4"/>
            </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="Preview" TextWrapping="Wrap"/></ScrollViewer>
    </DockPanel>
</Window>
