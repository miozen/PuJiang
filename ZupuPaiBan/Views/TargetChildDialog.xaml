<Window x:Class="ZupuPaiBan.Views.TargetChildDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新增生物子女" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" MinWidth="380">
    <StackPanel Margin="18">
        <TextBlock Text="将为以下人物新增生物子女："/>
        <TextBlock x:Name="ParentLabel" Margin="0,5,0,12" TextWrapping="Wrap" FontWeight="Bold"/>
        <TextBlock Text="子女姓名："/>
        <TextBox x:Name="ChildNameBox" Margin="0,5,0,12" MinWidth="340" MaxLength="200"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" Padding="14,4" Margin="0,0,8,0"/>
            <Button Content="添加" IsDefault="True" Padding="14,4" Click="Add_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
